{
  "name": "laya-sponsor-skip",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Fun Chrome extension: finds sponsor reads in YouTube videos with a local Laya decision model and skips them. No cloud, no key.",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "live-check": "node test/live-check.mjs",
    "serve": "python3 -m http.server 8788",
    "judge": "python3 ../laya-adblock/server/server.py",
    "judge:heuristic": "LAYA_HEURISTIC=1 python3 ../laya-adblock/server/server.py",
    "icons": "python3 icons/make_icons.py"
  }
}
